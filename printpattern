#include<stdio.h>
void printPattern(int rows);
void printPattern(int rows)
{
    for(int i=1;i<=rows;i++)
    {
        for(int j=1;j<=i;j++)
        {
            printf("* " );
        }
        printf("\n");
        
    }
    
    
}
int main()
{
    int rows;
    printf("Enter rows:\n");
    scanf("%d", &rows);
    printPattern(rows);
    return 0;
}



