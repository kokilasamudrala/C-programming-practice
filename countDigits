#include<stdio.h>
void countDigits(int n);
void countDigits(int n)
{
    int count=0;
    while(n>0)
    {
        count++;
        n=n/10;
    }
    printf("Number of digits=%d",count);
}

int main()
{
    int n;
    printf("Enter n value:\n");
    scanf("%d", &n);
    countDigits(n);
    return 0;
}



