#include <stdio.h>

int armstrong(int n)
{
    int original = n, rem, sum = 0;

    while (n > 0)
    {
        rem = n % 10;
        sum = sum + rem * rem * rem;
        n = n / 10;
    }

    if (original == sum)
        return 1;
    else
        return 0;
}

int main()
{
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    printf("%d", armstrong(n));

    return 0;
}




