#include <stdio.h>

int fibonacci(int n)
{
    int first=0,second=1,next;
    
    for(int i=1;i<=n;i++)
    {
        next=first+second;
        first=second;
        second=next;
    }
    return(first);
}
int main()
{
    int n;
    int res;

    printf("Enter a number: ");
    scanf("%d", &n);
    
    res=fibonacci(n);
    
    printf("Fibonacci=%d ",res );

   

    return 0;
}


