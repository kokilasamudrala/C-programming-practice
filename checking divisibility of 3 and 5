#include <stdio.h>

int main()
{
    int x;
    printf("enter x value:\n");
    scanf("%d", &x);
    if(x<=0)
    {
        printf("It is an invalid input ");
    }
    
    else if(x%3==0 && x%5==0)
    {
        printf("%d is divisible by both 3 and 5",x);
    }
    else if(x%3==0)
    {
        printf("%d is divisible by 3",x);
    }
    else if(x%5==0)
    {
        printf("%d is divisible by 5",x);
    }
    else
    {
        printf("%d is not divisible by both 3 and 5 ",x);
    }
        return 0;
}
