#include<stdio.h>
void reverseNumber(void);
void reverseNumber(void)
{
    int n,digit,reverse=0;
    printf("Enter n number:\n");
    scanf("%d", &n);
    
     while (n > 0)
    {
        digit = n % 10;
        reverse=reverse*10+digit;
        n = n / 10;
    }

    printf("reverseNumber = %d\n", reverse);
}
int main()
{
   reverseNumber();
    return 0;
}



